# Ledger — deployment configuration.
#
# Copy to `.env` and edit as needed:  cp .env.example .env
# These variables are read by docker-compose.yml. They are NOT baked into the
# application bundle — Ledger has no client-side environment variables and no
# secrets of any kind, because it talks to no server.

# Port published on the host. Open http://localhost:${LEDGER_PORT} after starting.
LEDGER_PORT=8080

# Interface the port is published on.
#   0.0.0.0   — reachable from other devices on your network (the default)
#   127.0.0.1 — reachable only from this machine; use this when a reverse proxy
#               such as Caddy, Traefik or nginx sits in front of Ledger
LEDGER_BIND=0.0.0.0
